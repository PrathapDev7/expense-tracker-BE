# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
.next/
.env

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.index
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Runtime animation cache (fetched on demand, regenerable)
.cache/

# Minified compositions produced by Seeders/BuildAnimationIndexFromArchive.js
Seeders/data/lottie_assets/
Seeders/data/exercise_animation_index.enriched.json

# The raw catalog Seeders/FetchAnimations.js writes (~92 MB) is too big for git.
# Its gzipped twin, exercise_animations.json.gz (~12 MB), IS committed --
# that is what lets a deployed host seed itself. The trailing slash-free path
# below matches only the .json, so the .gz is not caught by it.
# Regenerate with "npm run fetchAnimations" then "npm run packAnimations".
Seeders/data/exercise_animations.json
Seeders/data/exercise_animations.json.gz.partial
