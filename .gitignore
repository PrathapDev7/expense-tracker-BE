# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
.next/
.env

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.index
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Runtime animation cache (fetched on demand, regenerable)
.cache/

# Minified compositions produced by Seeders/BuildAnimationIndexFromArchive.js
Seeders/data/vfe_lottie/
Seeders/data/vfe_animation_index.enriched.json

# Compositions embedded per line by Seeders/FetchVfeLottie.js (~92 MB).
# Regenerable with "npm run fetchVfeLottie"; the API reads them from Mongo.
Seeders/data/vfe_animation_index_lottie.json
